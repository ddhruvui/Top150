#!/usr/bin/env bash
# aws s3 against results/Core105 on the data volume — where every CORE-105 output lives.
#   vol105 ls derived/core105/predict/
#   vol105 cp derived/core105/predict/suggestions.json /tmp/x --quiet
#   vol105 ls --recursive --summarize          # whole prefix
# Paths first, flags after. A bare relative path is a results/Core105 path. It can
# never write, move or delete anything outside results/Core105 (res_s3 in
# scripts/_common.sh refuses it); to READ anything else on the volume use `srcvol`.
set -euo pipefail
. "$(dirname "$0")/_env105.sh"
res_s3 "$@"
