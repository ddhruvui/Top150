#!/usr/bin/env bash
# READ-ONLY aws s3 against the data volume root (crimtr8kbf), endpoint/region preset.
#   srcvol ls data/eod_bulk/US/
#   srcvol cp m1/sessions.parquet /tmp/sessions.parquet --quiet
#
# This is the ONLY sanctioned way to read the source tape from a helper. It
# accepts ls/cp/sync only, paths first and flags after, and a cp/sync destination
# must be an explicit local path — so a transposed cp cannot turn into a write.
# A separate system owns everything outside results/; nothing here may add to,
# change or delete from it.
#
# For this repo's own outputs (results/Top150: pod logs, derived, models) use vol150.
set -euo pipefail
. "$(dirname "$0")/_env150.sh"
src_s3 "$@"
