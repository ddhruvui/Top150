#!/usr/bin/env bash
# aws s3 against results/Top150 on the data volume — where every TOP-150 output lives.
#   vol150 ls derived/top150/predict/
#   vol150 cp derived/top150/predict/suggestions.json /tmp/x --quiet
#   vol150 ls --recursive --summarize          # whole prefix
# Paths first, flags after. A bare relative path is a results/Top150 path. It can
# never write, move or delete anything outside results/Top150 (res_s3 in
# scripts/_common.sh refuses it); to READ anything else on the volume use `srcvol`.
set -euo pipefail
. "$(dirname "$0")/_env150.sh"
res_s3 "$@"
