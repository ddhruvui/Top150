#!/usr/bin/env bash
# aws s3 against the TOP-150 CALC volume (k4cli3aj48), endpoint/region preset.
#   vol150 ls derived/top150/predict/
#   vol150 cp derived/top150/predict/suggestions.json /tmp/x --quiet
# Path rule (same as daily-pipeline's vol): a bare relative path is a CALC-volume
# path; anything starting with '/', '.', '-' or 's3://' passes through untouched.
# To read the PROD volume use daily-pipeline's `vol` — never write to it from here.
set -euo pipefail
. "$(dirname "$0")/_env150.sh"
SUB="$1"; shift
ARGS=()
for a in "$@"; do
  case "$a" in
    s3://*|/*|.*|-*) ARGS+=("$a") ;;
    *)               ARGS+=("$CALC_BUCKET/$a") ;;
  esac
done
exec aws s3 "$SUB" --region "$RUNPOD_S3_REGION" --endpoint-url "$RUNPOD_S3_ENDPOINT" "${ARGS[@]}"
