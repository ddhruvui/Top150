/data_borrow/
/data_calendar/
/data_finbert/
/data_quality/
/m1/
/m1x/
.DS_Store
__pycache__/
*.pyc
.env

# --- prediction stack: generated / downloaded, never sourced from git ---
.pytest_cache/
derived_*/
artifacts/models/
artifacts/scores/
scratch*/
*.log
