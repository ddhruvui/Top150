# Copy to .env (gitignored) and fill in. Read by tools/publish_mongo.py (the
# mirror's publish step) and by app/backend when run from this repo.
# On Vercel the same names go under Project -> Settings -> Environment Variables.

# MongoDB Atlas. MONGO_URI may keep Atlas's literal `<db_password>` placeholder;
# it is filled in from DB_PASSWORD (URL-encoded) at connect time.
DB_PASSWORD=
MONGO_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=Top150

# Report bundle name: reports/<bundle> locally, "<bundle>/<section>" documents in Mongo.
BUNDLE=top150
