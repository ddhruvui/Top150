# Copy to .env for local runs (the file is gitignored). On Vercel, set the same
# names under Project -> Settings -> Environment Variables.

# MongoDB Atlas. MONGO_URI may keep Atlas's literal `<db_password>` placeholder;
# it is filled from DB_PASSWORD (URL-encoded) at startup.
DB_PASSWORD=
MONGO_URI='mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0'
MONGO_DB=Top150

# Which published bundle to serve (documents are keyed "<bundle>/<section>").
BUNDLE=top150

# Comma-separated browser origins allowed to call this API. Empty = any origin.
# Production: CORS_ORIGIN=https://top150fe.onrender.com   (the Render site)
CORS_ORIGIN=

# --- local only ---
# Serve the JSON bundle from a directory instead of Mongo (forces file mode):
# REPORTS_DIR=../../reports/top150
# PORT=8787
